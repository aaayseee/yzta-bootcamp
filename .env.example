# Application bootstrap
LOYALCART_ADMIN_USERNAME=admin
LOYALCART_ADMIN_EMAIL=admin@example.com
LOYALCART_ADMIN_PASSWORD=change-this-with-a-strong-password
LOYALCART_INVITE_CODE=change-this-invite-code
LOYALCART_API_KEY=change-this-api-key
LOYALCART_API_URL=http://127.0.0.1:8000
LOYALCART_APP_URL=http://localhost:8501

# SQLite development database
DB_ENGINE=sqlite
SQLITE_PATH=loyalcart.db

# MySQL production database
# DB_ENGINE=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=loyalcart
# MYSQL_PASSWORD=change-this-database-password
# MYSQL_ROOT_PASSWORD=change-this-root-password
# MYSQL_DB=loyalcart

# Telegram Bot API
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_CHURN_THRESHOLD=70

# Password reset email (SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=LoyalCart <no-reply@example.com>
# SMTP_USE_TLS=1
